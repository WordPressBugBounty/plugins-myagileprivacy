#: admin/views/policy_assistant_html.php:1127
msgid "process sensitive personal data of consumers (excluding data processed solely to complete a payment transaction); or"
msgstr "sensible personenbezogene Daten von Verbrauchern verarbeiten (ausgenommen Daten, die ausschließlich zur Durchführung einer Zahlungstransaktion verarbeitet werden); oder"

