#: admin/views/policy_assistant_html.php:2541
msgid "Reviews / Feedback collection"
msgstr ""

#: admin/views/policy_assistant_html.php:2542
msgid "Customer reviews, ratings, testimonials, surveys, and feedback forms."
msgstr ""

