msgid "I do not use Google services that require Consent Mode v2 (e.g. Analytics, Ads, Tag Manager)"
msgstr "No utilizo servicios de Google que requieran Consent Mode v2 (p. ej., Analytics, Ads, Tag Manager)"

#: admin/views/inc/fields.consent_mode_tab.php:77
msgid "Hides the Consent Mode options and stops the related reminders. Enable it if the site does not use Google Analytics, Google Ads or Google Tag Manager."
msgstr "Oculta las opciones del modo de consentimiento y detiene los avisos relacionados. Actívalo si el sitio no utiliza Google Analytics, Google Ads ni Google Tag Manager."

#: admin/views/inc/fields.consent_mode_tab.php:97
#: admin/views/inc/fields.consent_mode_tab.php:115
